{
  "$comment": "Single source of truth for the indexer <-> extension protocol. Run `node protocol/gen.mjs` after editing. Field names are camelCase; Rust fields are generated in snake_case with serde renames. Types: string, bool, u32, u64, f64, bytes (base64 string), Name (struct or enum), T[] (array), and a trailing ? on a field name marks it optional.",
  "version": 8,
  "enums": {
    "IndexPhase": [
      "discover",
      "hash",
      "parse",
      "resolve",
      "analyse",
      "persist",
      "history",
      "idle"
    ],
    "NodeKind": [
      "dir",
      "file",
      "module",
      "class",
      "function",
      "method",
      "type",
      "constant"
    ],
    "EdgeKind": [
      "contains",
      "imports",
      "calls",
      "references",
      "inherits",
      "implements",
      "cochanges"
    ],
    "Confidence": [
      "syntactic",
      "semantic",
      "historical"
    ]
  },
  "types": {
    "InitializeParams": {
      "workspaceRoot": "string",
      "storePath": "string",
      "clientVersion": "string",
      "capDataFiles?": "bool"
    },
    "InitializeResult": {
      "serverVersion": "string",
      "protocolVersion": "u32"
    },
    "PingResult": {
      "uptimeMs": "u64"
    },
    "ProgressParams": {
      "phase": "IndexPhase",
      "done": "u64",
      "total": "u64",
      "message?": "string"
    },
    "MapChangedParams": {
      "epoch": "u64",
      "layout": "bool"
    },
    "Rect": {
      "x": "f64",
      "y": "f64",
      "w": "f64",
      "h": "f64"
    },
    "MapInfo": {
      "epoch": "u64",
      "files": "u64",
      "phase": "IndexPhase",
      "worldW": "f64",
      "worldH": "f64",
      "tilePx": "f64",
      "minPx": "f64",
      "maxZoom": "u32",
      "rootName": "string"
    },
    "TileKey": {
      "z": "u32",
      "x": "u32",
      "y": "u32"
    },
    "TilesParams": {
      "tiles": "TileKey[]"
    },
    "Tile": {
      "z": "u32",
      "x": "u32",
      "y": "u32",
      "data": "bytes"
    },
    "TilesResult": {
      "epoch": "u64",
      "tiles": "Tile[]"
    },
    "SlotParams": {
      "slot": "u32"
    },
    "NodeInfo": {
      "slot": "u32",
      "id": "string",
      "kind": "NodeKind",
      "name": "string",
      "qualified": "string",
      "path": "string",
      "lang": "string",
      "loc": "u32",
      "startLine": "u32",
      "endLine": "u32",
      "files": "u32",
      "generated": "bool",
      "test": "bool",
      "rect?": "Rect",
      "ancestors": "u32[]",
      "inCount": "u32",
      "outCount": "u32",
      "load": "f64",
      "community": "u32",
      "blastCount": "u32",
      "complexity": "u32",
      "deadCandidate": "bool",
      "inCycle": "bool",
      "data": "bool",
      "areaLines": "u32",
      "churn": "u32",
      "owner?": "string",
      "ownerShare": "f64"
    },
    "LocateParams": {
      "path": "string",
      "line?": "u32"
    },
    "LocateResult": {
      "node?": "NodeInfo"
    },
    "SearchParams": {
      "query": "string",
      "limit": "u32"
    },
    "SearchHit": {
      "slot": "u32",
      "kind": "NodeKind",
      "name": "string",
      "path": "string",
      "line": "u32",
      "score": "f64"
    },
    "SearchResult": {
      "hits": "SearchHit[]",
      "elapsedMs": "f64"
    },
    "FilesChangedParams": {
      "paths": "string[]"
    },
    "FilesChangedResult": {
      "changed": "bool",
      "elapsedMs": "f64"
    },
    "Timings": {
      "warmLoadMs": "f64",
      "firstMapMs": "f64",
      "discoverMs": "f64",
      "hashMs": "f64",
      "totalMs": "f64"
    },
    "StatusResult": {
      "phase": "IndexPhase",
      "files": "u64",
      "epoch": "u64",
      "timings": "Timings",
      "rssMb": "f64"
    },
    "EdgesParams": {
      "slot": "u32",
      "limit": "u32"
    },
