    },
    "HistoryFileResult": {
      "churn": "u32",
      "commits": "u32",
      "owner?": "string",
      "ownerShare": "f64",
      "partners": "CouplingView[]"
    },
    "BlameResult": {
      "authors": "AuthorLines[]"
    },
    "HiddenPair": {
      "a": "NodeRef",
      "b": "NodeRef",
      "degree": "f64",
      "shared": "u32"
    },
    "HiddenResult": {
      "pairs": "HiddenPair[]",
      "total": "u32"
    },
    "MisplacedView": {
      "node": "NodeRef",
      "home": "NodeRef",
      "share": "f64"
    },
    "MisplacedResult": {
      "items": "MisplacedView[]",
      "total": "u32"
    },
    "HistorySummary": {
      "available": "bool",
      "commits": "u32",
      "head?": "string",
      "topAuthors": "string[]",
      "maxChurn": "u32",
      "churnDays": "u32",
      "coupledFiles": "u32",
      "hiddenPairs": "u32"
    },
    "RefreshResult": {
      "changed": "bool"
    },
    "NbNode": {
      "node": "NodeRef",
      "column": "u32",
      "load": "f64",
      "inCount": "u32",
      "outCount": "u32"
    },
    "NbEdge": {
      "from": "u32",
      "to": "u32",
      "kind": "EdgeKind",
      "confidence": "Confidence",
      "count": "u32"
    },
    "NeighbourhoodResult": {
      "centre": "u32",
      "nodes": "NbNode[]",
      "edges": "NbEdge[]",
      "dependents": "u32",
      "dependencies": "u32",
      "millis": "f64"
    },
    "BetweenParams": {
      "from": "u32",
      "to": "u32"
    },
    "PathView": {
      "nodes": "NodeRef[]"
    },
    "PathResult": {
      "from": "NodeRef",
      "to": "NodeRef",
      "paths": "PathView[]",
      "reversed": "bool"
    },
    "ReviewItem": {
      "node": "NodeRef",
      "load": "f64",
      "blastCount": "u32",
      "committed": "bool"
    },
    "ReviewResult": {
      "available": "bool",
      "baseName?": "string",
      "base?": "string",
