      "name": "string",
      "otherKind": "NodeKind",
      "path": "string",
      "route": "Rect[]"
    },
    "EdgesResult": {
      "slot": "u32",
      "edges": "EdgeView[]",
      "total": "u32"
    },
    "NodeRef": {
      "slot": "u32",
      "name": "string",
      "kind": "NodeKind",
      "path": "string",
      "line": "u32"
    },
    "ContextParams": {
      "slot": "u32",
      "limit": "u32"
    },
    "ContextResult": {
      "node": "NodeInfo",
      "callers": "NodeRef[]",
      "callees": "NodeRef[]",
      "importers": "NodeRef[]",
      "imports": "NodeRef[]",
      "tests": "NodeRef[]",
      "blast": "NodeRef[]",
      "blastCount": "u32"
    },
    "PathParams": {
      "path": "string"
    },
    "LensItem": {
      "slot": "u32",
      "line": "u32",
      "callers": "u32",
      "blast": "u32",
      "tests": "u32",
      "complexity": "u32"
    },
    "LensesResult": {
      "lenses": "LensItem[]"
    },
    "CycleView": {
      "members": "NodeRef[]",
      "breakFrom?": "NodeRef",
      "breakTo?": "NodeRef"
    },
    "CyclesResult": {
      "files": "CycleView[]",
      "dirs": "CycleView[]"
    },
    "LimitParams": {
      "limit": "u32"
    },
    "DeadResult": {
      "items": "NodeRef[]",
      "total": "u32"
    },
    "RankedRef": {
      "node": "NodeRef",
      "load": "f64",
      "blastCount": "u32"
    },
    "SummaryResult": {
      "files": "u32",
      "communities": "u32",
      "fileCycles": "u32",
      "dirCycles": "u32",
      "dead": "u32",
      "analysisMs": "f64",
      "topLoadBearing": "RankedRef[]"
    },
    "SettingsParams": {
      "capDataFiles": "bool"
    },
    "CouplingView": {
      "node": "NodeRef",
      "degree": "f64",
      "shared": "u32",
      "hidden": "bool",
      "rect?": "Rect"
    },
    "AuthorLines": {
      "author": "string",
