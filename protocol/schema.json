{
  "$comment": "Single source of truth for the indexer <-> extension protocol. Run `node protocol/gen.mjs` after editing. Field names are camelCase; Rust fields are generated in snake_case with serde renames. Types: string, bool, u32, u64, f64, bytes (base64 string), Name (struct or enum), T[] (array), and a trailing ? on a field name marks it optional.",
  "version": 1,
  "enums": {
    "IndexPhase": ["discover", "hash", "parse", "resolve", "analyse", "persist", "history", "idle"]
  },
  "types": {
    "InitializeParams": {
      "workspaceRoot": "string",
      "storePath": "string",
      "clientVersion": "string"
    },
    "InitializeResult": {
      "serverVersion": "string",
      "protocolVersion": "u32"
    },
    "PingResult": {
      "uptimeMs": "u64"
    },
    "ProgressParams": {
      "phase": "IndexPhase",
      "done": "u64",
      "total": "u64",
      "message?": "string"
    }
  },
  "requests": {
    "initialize": { "params": "InitializeParams", "result": "InitializeResult" },
    "ping": { "params": null, "result": "PingResult" },
    "shutdown": { "params": null, "result": null }
  },
  "notifications": {
    "index/progress": "ProgressParams"
  }
}
